{
  "name": "@the-inclusionist/game-space-cadet",
  "version": "0.1.0",
  "description": "Space Cadet pinball engine ported to TypeScript, running as a consumer of the Inclusionist accessibility engine. Faithful physics, collision, z-buffer and mission state machine; original table data is never vendored.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/cartridge.d.ts",
      "default": "./dist-lib/cartridge.js"
    },
    "./style.css": "./dist-lib/cartridge.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "docs/LICENSES.md",
    "docs/CREDITS.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "validate": "npm run typecheck && npm run build:lib && npm run build && vitest run",
    "data:extract": "node scripts/extract-original-data.mjs"
  },
  "peerDependencies": {
    "@the-inclusionist/engine": "^9.0.0"
  },
  "devDependencies": {
    "@the-inclusionist/engine": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
