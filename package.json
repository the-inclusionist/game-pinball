{
  "name": "@the-inclusionist/game-space-cadet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space Cadet pinball engine ported to TypeScript, running as a consumer of the Inclusionist accessibility engine. Faithful physics, collision, z-buffer and mission state machine; original table data is never vendored.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "validate": "npm run typecheck && vitest run && vite build",
    "data:extract": "node scripts/extract-original-data.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@the-inclusionist/engine": "file:../SP-the-inclusionist-tracer"
  }
}
